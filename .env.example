NODE_ENV=development
PORT=3000
# Dev usa un Postgres LOCAL (docker-compose), separado por completo de la Cloud SQL
# de produccion. Levantarlo con: docker compose up -d db redis
# Luego: cd backend && npx prisma db push && npm run seed:minimal
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gemeseg?schema=public
# Tope del pool pg/Prisma (default 3). En prod no subirlo: Cloud SQL f1-micro ~25 conexiones.
# DATABASE_POOL_MAX=3
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_SECRET=your-jwt-secret
FRONTEND_URL=http://localhost:5173

# --- SignWell (firma electrónica de Ventas > Contratos) ---
# Header X-Api-Key. Sin esto, "Enviar a Firma Electrónica" falla con
# "SIGNWELL_API_KEY no configurada".
SIGNWELL_API_KEY=
# true (default si se omite) = documentos de prueba: no cuentan contra la
# cuota paga ni son legalmente vinculantes. Poner en "false" solo cuando el
# envío ya esté verificado de punta a punta.
SIGNWELL_TEST_MODE=true
# Id devuelto por POST /api/v1/hooks al registrar el webhook (una vez que
# haya una URL pública de callback, ej. en producción) — sin esto, los
# webhooks entrantes de SignWell se ignoran y el contrato solo llega a
# SIGNED por la subida manual del PDF firmado. Ver CONTRATOS-PLAN.md.
SIGNWELL_WEBHOOK_ID=

# --- Vertex AI (análisis con IA del "archivo único" de Reclutamiento) ---
# Ojo: el endpoint de Vertex AI NO acepta API keys — exige credenciales de
# servicio (OAuth2). No hace falta crear una nueva: se reutiliza la misma que ya
# usa Drive (backend/google-service-account.json en local,
# GOOGLE_SERVICE_ACCOUNT_JSON como secreto en Cloud Run). Esto importa porque
# esta organización de GCP tiene bloqueada la creación de claves de service
# account por política (iam.serviceAccountKeys.create), así que una credencial
# nueva ni siquiera se podría generar.
#
# Falta, del lado de GCP: habilitar la API de Vertex AI en el proyecto y darle
# el rol "Vertex AI User" (roles/aiplatform.user) a esa service account.
# Mientras GOOGLE_VERTEX_PROJECT esté vacío, el análisis con IA queda
# deshabilitado y Reclutamiento sigue funcionando a mano (mismo criterio que
# CacheService con REDIS_HOST vacío).
#
# GOOGLE_VERTEX_LOCATION ya existía en backend/.env pero ningún archivo del
# código la leía todavía — se conserva ese nombre a propósito, en vez de
# introducir uno nuevo en paralelo.
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=us-central1

# Modelo a usar. El default en código es gemini-2.5-flash, que es el más nuevo
# al que el proyecto agentes-504115 tiene acceso hoy (verificado 2026-09-16: la
# serie Gemini 3.x responde 404 NOT_FOUND ahí).
# ⚠️ Google retira los modelos Gemini 2.5 el 16 de octubre de 2026. Antes de esa
# fecha hay que conseguir acceso a la serie 3.x en el proyecto y apuntar esta
# variable al modelo nuevo — está por entorno justamente para que ese cambio no
# necesite un despliegue de código.
GOOGLE_VERTEX_MODEL=
