generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model Company {
  id             Int      @id @default(autoincrement())
  name           String
  slug           String   @unique
  logoUrl        String?
  primaryColor   String   @default("#100F31")
  secondaryColor String   @default("#12375F")
  accentColor    String   @default("#EE3B1B")
  bgColor        String   @default("#f8fafc")
  textColor      String   @default("#1e293b")
  domain         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  users          User[]
  sections       CompanySection[]
  custodias      Custodia[]
  kanbanColumns  KanbanColumn[]
  candidates     Candidate[]
  contractTemplates ContractTemplate[]
  contracts      Contract[]
  certifications Certification[]
  logTemplates   LogTemplate[]
  logEntries     LogEntry[]
  driveFolders   EmployeeDriveFolder[]
  documentTypes  DocumentType[]
  employeeDocuments EmployeeDocument[]
  folderConfigs  FolderConfig[]
  jobPositions   JobPosition[]
  sistemasVerificacion SistemaVerificacion[]
  movimientosPersonal  MovimientoPersonal[]
  documentReviews    DocumentReview[]
  documentReviewHistory DocumentReviewHistory[]
  salesGoals        SalesGoal[]
  clientVisits      ClientVisit[]
  leads             Lead[]
  salesApiKeys      SalesApiKey[]
  salesTemplates    SalesTemplate[]
  salesContracts    SalesContract[]
  entidades            Entidad[]
  requisitosDocumento  RequisitoDocumento[]
  asignacionesGuardia  AsignacionGuardia[]
  alertasVencimiento   AlertaVencimiento[]
  guardiaContactos     GuardiaContacto[]
  guardiaFichasPersonales GuardiaFichaPersonal[]
  personalFieldDefinitions PersonalFieldDefinition[]
  administrativeStaffFichas AdministrativeStaffFicha[]
  cedulaMergeLogs      CedulaMergeLog[]
}

model Department {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id                 Int              @id @default(autoincrement())
  fullName           String
  email              String           @unique
  password           String?
  documentNumber     String?
  position           String?
  isActive           Boolean          @default(true)
  departmentId       Int?
  roleId             Int?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  role               UserRole         @default(EMPLOYEE)
  activeAgentId      Int?
  companyId          Int?
  aiLogs             AiLog[]
  conversations      Conversation[]
  createdProjects    Project[]
  projectMemberships ProjectMember[]
  taskAssignees      TaskAssignee[]
  toolAssignments    ToolAssignment[]
  toolAudits         ToolAuditLog[]
  activeAgent        Agent?           @relation("UserActiveAgent", fields: [activeAgentId], references: [id])
  company            Company?         @relation(fields: [companyId], references: [id])
  department         Department?      @relation(fields: [departmentId], references: [id])
  roleRelation       Role?            @relation(fields: [roleId], references: [id])
  agentLinks         UserAgent[]
  permissions        UserPermission[]
  createdCustodias   Custodia[]
  createdCandidates  Candidate[]
  candidateMoves     CandidateHistory[]
  contractTemplates  ContractTemplate[]
  contracts          Contract[]
  certifications     Certification[]
  logTemplates       LogTemplate[]
  logEntries         LogEntry[]
  salesGoals         SalesGoal[]
  clientVisits       ClientVisit[]
  assignedLeads      Lead[]
  createdSalesTemplates   SalesTemplate[]
  createdSalesContracts   SalesContract[]
  documentReviews         DocumentReview[]
  documentReviewActions   DocumentReviewHistory[]
  asignacionesCreadas     AsignacionGuardia[]
  expiryConfirmations     EmployeeDocument[]
  movimientosPersonalCreados          MovimientoPersonal[]
  movimientoPersonalItemsCompletados  MovimientoPersonalItem[]
  cedulaMerges                        CedulaMergeLog[]
}

model Project {
  id          Int             @id @default(autoincrement())
  name        String
  description String?
  status      ProjectStatus   @default(ACTIVE)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  createdById Int
  createdBy   User            @relation(fields: [createdById], references: [id])
  members     ProjectMember[]
  tasks       Task[]
}

model ProjectMember {
  id        Int        @id @default(autoincrement())
  role      MemberRole @default(MEMBER)
  projectId Int
  userId    Int
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

model Task {
  id             Int            @id @default(autoincrement())
  title          String
  description    String?
  status         TaskStatus     @default(TODO)
  priority       Priority       @default(MEDIUM)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  projectId      Int
  estimatedHours Float?
  endDate        DateTime?
  startDate      DateTime?
  project        Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignees      TaskAssignee[]
}

model TaskAssignee {
  id     Int  @id @default(autoincrement())
  taskId Int
  userId Int
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
}

model Agent {
  id            Int            @id @default(autoincrement())
  name          String
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  createdBy     Int?
  instructions  String
  scope         String         @default("GLOBAL")
  updatedAt     DateTime       @updatedAt
  conversations Conversation[]
  activeUsers   User[]         @relation("UserActiveAgent")
  userLinks     UserAgent[]

  @@unique([createdBy, name])
}

model UserAgent {
  id        Int      @id @default(autoincrement())
  userId    Int
  agentId   Int
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, agentId])
}

model Conversation {
  id        Int           @id @default(autoincrement())
  userId    Int
  context   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  agentId   Int
  messages  ChatMessage[]
  agent     Agent         @relation(fields: [agentId], references: [id])
  user      User          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([agentId])
}

model ChatMessage {
  id             Int          @id @default(autoincrement())
  conversationId Int
  role           String
  content        String
  tokensUsed     Int?
  model          String?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

model AiLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  action       String
  model        String
  tokensUsed   Int?
  success      Boolean
  errorMessage String?
  metadata     Json?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
}

model Tool {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  category    String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  assignments ToolAssignment[]
}

model ToolAssignment {
  id         Int            @id @default(autoincrement())
  toolId     Int
  userId     Int
  version    String?
  licenseKey String?
  assignedAt DateTime       @default(now())
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tool       Tool           @relation(fields: [toolId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id])
  audits     ToolAuditLog[]

  @@unique([toolId, userId])
}

model ToolAuditLog {
  id           Int            @id @default(autoincrement())
  assignmentId Int
  action       String
  performedBy  Int
  details      String?
  createdAt    DateTime       @default(now())
  assignment   ToolAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  performer    User           @relation(fields: [performedBy], references: [id])

  @@index([assignmentId])
  @@index([createdAt])
}

model CacaoSupplier {
  id           Int               @id @default(autoincrement())
  name         String
  contact      String?
  phone        String?
  paymentTerms String?
  bank         String?
  companyId    Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  payables     CacaoPayable[]
  receptions   CacaoReception[]
  settlements  CacaoSettlement[]
}

model CacaoClient {
  id          Int               @id @default(autoincrement())
  name        String
  country     String?
  contact     String?
  email       String?
  phone       String?
  companyId   Int
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  receivables CacaoReceivable[]
  shipments   CacaoShipment[]
}

model CacaoQuality {
  id               Int        @id @default(autoincrement())
  name             String     @unique
  fixedPrice       Float?
  humidityDiscount Float      @default(7)
  impurityDiscount Float      @default(1)
  isFixedPrice     Boolean    @default(false)
  lots             CacaoLot[]
}

model CacaoLot {
  id           Int                  @id @default(autoincrement())
  code         String               @unique
  qualityId    Int
  netWeight    Float
  averageCost  Float                @default(0)
  status       String               @default("OPEN")
  companyId    Int
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  differential Float?
  kardex       CacaoKardex[]
  quality      CacaoQuality         @relation(fields: [qualityId], references: [id])
  priceFixings CacaoPriceFixing[]
  receptions   CacaoReception[]
  settlements  CacaoSettlementLot[]
  shipments    CacaoShipmentLot[]
}

model CacaoReception {
  id               Int           @id @default(autoincrement())
  date             DateTime
  supplierId       Int
  guideNumber      String
  grossWeight      Float
  tare             Float         @default(0)
  netWeight        Float
  humidity         Float         @default(0)
  impurities       Float         @default(0)
  provisionalPrice Float         @default(0)
  qualityId        Int?
  lotId            Int?
  companyId        Int
  createdBy        Int
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  differential     Float?
  unitOfMeasure    String        @default("KG")
  lot              CacaoLot?     @relation(fields: [lotId], references: [id])
  supplier         CacaoSupplier @relation(fields: [supplierId], references: [id])
}

model CacaoSettlement {
  id              Int                  @id @default(autoincrement())
  date            DateTime
  supplierId      Int
  periodStart     DateTime
  periodEnd       DateTime
  totalNetWeight  Float                @default(0)
  totalDeductions Float                @default(0)
  finalPrice      Float                @default(0)
  totalAmount     Float                @default(0)
  status          String               @default("PENDING")
  companyId       Int
  createdBy       Int
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  payable         CacaoPayable?
  supplier        CacaoSupplier        @relation(fields: [supplierId], references: [id])
  lots            CacaoSettlementLot[]
}

model CacaoSettlementLot {
  id           Int             @id @default(autoincrement())
  settlementId Int
  lotId        Int
  quantity     Float
  unitCost     Float
  createdAt    DateTime        @default(now())
  lot          CacaoLot        @relation(fields: [lotId], references: [id])
  settlement   CacaoSettlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)
}

model CacaoKardex {
  id            Int      @id @default(autoincrement())
  lotId         Int
  type          String
  quantity      Float
  unitCost      Float
  totalCost     Float
  balanceQty    Float
  balanceCost   Float
  date          DateTime
  reference     String?
  companyId     Int
  createdAt     DateTime @default(now())
  referenceUnit String?
  lot           CacaoLot @relation(fields: [lotId], references: [id])
}

model CacaoPriceFixing {
  id             Int       @id @default(autoincrement())
  lotId          Int
  referencePrice Float?
  differential   Float?
  fixedPrice     Float?
  pendingWeight  Float?
  fixedDate      DateTime?
  deadline       DateTime?
  status         String    @default("OPEN")
  companyId      Int
  createdBy      Int
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lot            CacaoLot  @relation(fields: [lotId], references: [id])
}

model CacaoShipment {
  id             Int                @id @default(autoincrement())
  date           DateTime
  clientId       Int
  contractRef    String
  totalWeight    Float
  totalCost      Float
  salePrice      Float
  margin         Float              @default(0)
  status         String             @default("PENDING")
  companyId      Int
  createdBy      Int
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  salePricePerKg Float
  totalWeightKg  Float
  unitOfMeasure  String             @default("KG")
  receivable     CacaoReceivable?
  client         CacaoClient        @relation(fields: [clientId], references: [id])
  lots           CacaoShipmentLot[]
}

model CacaoShipmentLot {
  id            Int           @id @default(autoincrement())
  shipmentId    Int
  lotId         Int
  quantity      Float
  unitCost      Float
  saleAmount    Float
  createdAt     DateTime      @default(now())
  quantityKg    Float
  unitOfMeasure String        @default("KG")
  lot           CacaoLot      @relation(fields: [lotId], references: [id])
  shipment      CacaoShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
}

model CacaoPayable {
  id           Int             @id @default(autoincrement())
  settlementId Int             @unique
  supplierId   Int
  totalAmount  Float
  paidAmount   Float           @default(0)
  dueDate      DateTime
  status       String          @default("PENDING")
  companyId    Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  settlement   CacaoSettlement @relation(fields: [settlementId], references: [id])
  supplier     CacaoSupplier   @relation(fields: [supplierId], references: [id])
  payments     CacaoPayment[]
}

model CacaoReceivable {
  id             Int            @id @default(autoincrement())
  shipmentId     Int            @unique
  clientId       Int
  totalAmount    Float
  receivedAmount Float          @default(0)
  dueDate        DateTime
  status         String         @default("PENDING")
  companyId      Int
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  payments       CacaoPayment[]
  client         CacaoClient    @relation(fields: [clientId], references: [id])
  shipment       CacaoShipment  @relation(fields: [shipmentId], references: [id])
}

model CacaoPayment {
  id           Int              @id @default(autoincrement())
  type         String
  amount       Float
  method       String           @default("TRANSFER")
  reference    String?
  companyId    Int
  createdAt    DateTime         @default(now())
  payableId    Int?
  receivableId Int?
  payable      CacaoPayable?    @relation(fields: [payableId], references: [id])
  receivable   CacaoReceivable? @relation(fields: [receivableId], references: [id])
}

model CacaoUnitConfig {
  id          Int      @id @default(autoincrement())
  name        String
  displayName String
  kgPerUnit   Float
  isDefault   Boolean  @default(false)
  companyId   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MemberRole {
  OWNER
  MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model CompanySection {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  section   String
  createdAt DateTime @default(now())
  @@unique([companyId, section])
}

model UserPermission {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   String
  canView   Boolean  @default(true)
  canWrite  Boolean  @default(false)
  createdAt DateTime @default(now())
  @@unique([userId, section])
}

enum CustodiaType {
  HACIENDA
  PUERTO
  VIP
}

enum CustodiaEstado {
  LISTO_PARA_CUSTODIAR
  EN_CAMINO
  LLEGO
}

model Custodia {
  id               Int            @id @default(autoincrement())
  numeroGuia       String         @unique
  tipoCustodia     CustodiaType
  estado           CustodiaEstado @default(LISTO_PARA_CUSTODIAR)
  choferName       String
  choferCedula     String         @default("")
  custodio1Name    String
  custodio1Cedula  String         @default("")
  custodio2Name    String
  custodio2Cedula  String         @default("")
  cliente          String         @default("")
  placa            String         @default("")
  direccionSalida  String         @default("")
  direccionLlegada String         @default("")
  fechaHoraSalida  DateTime?
  fechaHoraLlegada DateTime?
  observaciones    String?
  nombreHacienda   String?
  cantidadSacos    Int?
  contenedores     String[]
  companyId        Int
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy        Int
  creator          User           @relation(fields: [createdBy], references: [id])
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  @@index([companyId])
  @@index([estado])
  @@index([tipoCustodia])
}

enum CandidateStatus {
  POSTULADO
  VALIDACION_DOCUMENTAL
  TEST_PSICOLOGICO
  TEST_MEDICO
  APROBADO
  RECHAZADO
}

enum LogType {
  PERMISO_INGRESO
  RESPUESTA_ADMIN_CONTRATO
  NOVEDAD_OPERATIVA
  SALIDA_PERSONAL
}

model KanbanColumn {
  id           Int      @id @default(autoincrement())
  name         String
  position     Int      @default(0)
  color        String   @default("#718096")
  // Al mover un candidato a la columna marcada, se crea automáticamente su
  // caso de "Entrada" en MovimientoPersonal. Solo una columna por empresa
  // puede tener este valor en true (se aplica en KanbanService).
  triggersHire Boolean  @default(false)
  companyId    Int
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidates   Candidate[]
  createdAt    DateTime @default(now())
  @@unique([companyId, name])
  @@index([companyId])
}

model Candidate {
  id               Int              @id @default(autoincrement())
  fullName         String
  cedula           String
  phone            String?
  email            String?
  positionApplied  String
  availability     String?
  salaryExpected   Float?
  education        String?
  experience       String?
  references       String?
  observations     String?
  cvUrl            String?
  status           CandidateStatus  @default(POSTULADO)
  columnId         Int?
  column           KanbanColumn?    @relation(fields: [columnId], references: [id])
  companyId        Int
  company          Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy        Int
  creator          User             @relation(fields: [createdBy], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  history          CandidateHistory[]
  movimientosPersonal MovimientoPersonal[]
  @@unique([companyId, cedula])
  @@index([companyId])
}

model CandidateHistory {
  id          Int      @id @default(autoincrement())
  candidateId Int
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  fromColumn  String?
  toColumn    String
  notes       String?
  performedBy Int
  performer   User    @relation(fields: [performedBy], references: [id])
  createdAt   DateTime @default(now())
}

model ContractTemplate {
  id          Int          @id @default(autoincrement())
  name        String
  // Texto libre (no enum): el usuario define sus propios tipos de documento
  // ("Contrato Término Indefinido", "Acta de Entrega de Uniformes",
  // "Constancia Laboral", etc.) sin necesitar un cambio de código/migración
  // por cada tipo nuevo.
  type        String
  // Link de Drive del .docx fuente y ruta local tras descargarlo — mismo
  // patrón que SalesTemplate (ventas), ver ventas-templates.service.ts.
  driveUrl    String?
  docxPath    String?
  companyId   Int
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   Int
  creator     User         @relation(fields: [createdBy], references: [id])
  createdAt   DateTime     @default(now())
  fields      ContractField[]
  contracts   Contract[]
}

// Una fila por variable ([NOMBRE], [CEDULA], etc.) detectada en el .docx de
// la plantilla. systemField, si está presente, indica de qué dato del
// guardia se autocompleta (ver ContractService.buildAutoFillValues); si es
// null, el usuario la llena a mano al generar el contrato.
model ContractField {
  id           Int              @id @default(autoincrement())
  templateId   Int
  template     ContractTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  variableName String
  label        String
  isRequired   Boolean          @default(true)
  systemField  String?
  order        Int              @default(0)
}

model Contract {
  id            Int              @id @default(autoincrement())
  // Identifica al guardia por cédula (mismo patrón que AsignacionGuardia/
  // GuardiaFichaPersonal/Certification), no por FK a Candidate — así sigue
  // funcionando aunque el guardia ya no tenga un registro vivo en el
  // pipeline de reclutamiento.
  cedula        String
  nombreGuardia String
  templateId    Int
  template      ContractTemplate @relation(fields: [templateId], references: [id])
  fieldValues   Json?
  generatedUrl  String?
  status        String           @default("DRAFT")
  companyId     Int
  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     Int
  creator       User             @relation(fields: [createdBy], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  @@index([companyId, cedula])
}

model Certification {
  id          Int      @id @default(autoincrement())
  employeeName String
  cedula      String
  type        String
  issueDate   DateTime
  expiryDate  DateTime
  status      String   @default("ACTIVE")
  documentUrl String?
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   Int
  creator     User     @relation(fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  alerts      CertificationAlert[]
  @@index([companyId])
}

model CertificationAlert {
  id              Int            @id @default(autoincrement())
  certificationId Int
  certification   Certification  @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  daysBefore      Int
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
}

model LogTemplate {
  id        Int      @id @default(autoincrement())
  name      String
  type      LogType
  content   String
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy Int
  creator   User     @relation(fields: [createdBy], references: [id])
  createdAt DateTime @default(now())
  entries   LogEntry[]
}

model LogEntry {
  id         Int         @id @default(autoincrement())
  templateId Int?
  template   LogTemplate? @relation(fields: [templateId], references: [id])
  title      String
  content    String
  type       LogType
  companyId  Int
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy  Int
  creator    User        @relation(fields: [createdBy], references: [id])
  createdAt  DateTime    @default(now())
}

model EmployeeDriveFolder {
  id          Int      @id @default(autoincrement())
  employeeName String
  cedula      String
  // Rol/puesto extraído del nombre de carpeta "Nombre Apellido - Puesto" del
  // bucket Personal Administrativo (folderType='PERSONAL_ADMIN'). Null para
  // filas de Custodios/Personal (bucket CUMPLIMIENTO), que no lo tienen.
  puesto      String?
  folderId    String
  folderUrl   String
  folderType  String   @default("PERSONAL")
  lastSyncAt  DateTime?
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  @@unique([companyId, cedula])
}

model DocumentType {
  id          Int      @id @default(autoincrement())
  name        String
  folder      String
  required    Boolean  @default(true)
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  reviews     DocumentReview[]
  @@unique([companyId, folder, name])
}

model EmployeeDocument {
  id             Int      @id @default(autoincrement())
  employeeName   String
  cedula         String
  fileName       String
  fileUrl        String
  fileType       String
  driveFileId    String   @unique
  folder         String
  companyId      Int
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  // Vencimiento del documento (cédula, licencia, certificado, etc). Fase A:
  // RRHH las carga manualmente vía PATCH .../drive/documents/:driveFileId/expiry.
  // Fase B (futura): extracción asistida por IA desde el PDF, con esta misma
  // confirmación manual como paso final antes de dar la fecha por buena.
  issueDate         DateTime?
  expiryDate        DateTime?
  expiryConfirmedBy Int?
  expiryConfirmer   User?     @relation(fields: [expiryConfirmedBy], references: [id])
  alertasVencimiento AlertaVencimiento[]
  @@unique([companyId, driveFileId])
}

// Cliente/sitio al que se asignan guardias. tipo determina qué RequisitoDocumento
// (aplicaA=PUBLICA/PRIVADA) le aplican además de los GLOBAL y los propios (ENTIDAD).
model Entidad {
  id        Int      @id @default(autoincrement())
  nombre    String
  tipo      String   // 'PUBLICA' | 'PRIVADA'
  activo    Boolean  @default(true)
  // ID de la carpeta de Drive vinculada, si ya se sincronizó al menos una
  // vez (ver DriveService.syncEntidadesFolder). Ancla la identidad de la
  // entidad a una carpeta estable: si RRHH renombra la carpeta después, el
  // sync reconoce que sigue siendo la MISMA entidad (por este id, no por el
  // nombre) y solo actualiza `nombre` — evita duplicar la entidad y
  // desvincular por accidente sus RequisitoDocumento/historial ya creados.
  // Null para entidades creadas a mano que todavía no tienen carpeta, o
  // creadas antes de que existiera este campo (se ancla sola en el próximo
  // sync que las encuentre por nombre).
  driveFolderId String?
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  asignaciones AsignacionGuardia[]
  requisitos   RequisitoDocumento[]
  @@index([companyId])
}

// Documento requerido para poder asignar un guardia a una entidad.
// aplicaA = GLOBAL (mínimo de toda la empresa) | PUBLICA | PRIVADA (según el
// tipo de Entidad) | ENTIDAD (específico, requiere entidadId).
model RequisitoDocumento {
  id               Int      @id @default(autoincrement())
  nombre           String
  aplicaA          String
  entidadId        Int?
  entidad          Entidad? @relation(fields: [entidadId], references: [id], onDelete: Cascade)
  // Cada cuanto vence este tipo de documento (null = no vence / no aplica)
  duracionValor    Int?
  duracionUnidad   String?  // 'DIAS' | 'MESES' | 'ANIOS'
  // Con cuanta anticipacion avisar antes del vencimiento (Fase C, sin efecto todavía en Fase A)
  anticipacionValor  Int    @default(30)
  anticipacionUnidad String @default("DIAS")  // 'DIAS' | 'SEMANAS' | 'MESES'
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  alertasVencimiento AlertaVencimiento[]
  @@index([companyId])
  @@index([entidadId])
}

// Periodo en el que un guardia (identificado por cedula, sin tabla maestra
// propia — mismo patrón que Certification/Candidate/Custodia en este schema)
// está asignado a una Entidad. fechaFin null = asignación vigente.
// Historial de solo lectura: lo escribe únicamente el sync de Drive
// (DriveService.syncEntidadesFolder), nunca un formulario manual — ver
// GuardiaContacto abajo para el correo, que se desacopló de aquí porque esta
// tabla pasó a ser 100% generada automáticamente.
model AsignacionGuardia {
  id            Int       @id @default(autoincrement())
  cedula        String
  nombreGuardia String
  entidadId     Int
  entidad       Entidad   @relation(fields: [entidadId], references: [id], onDelete: Cascade)
  fechaInicio   DateTime
  fechaFin      DateTime? // null = asignacion vigente
  companyId     Int
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     Int
  creator       User      @relation(fields: [createdBy], references: [id])
  createdAt     DateTime  @default(now())
  @@index([companyId, cedula])
  @@index([entidadId])
}

// Correo de contacto del guardia (identificado por cédula, mismo patrón que
// el resto del módulo), independiente de en qué entidad esté asignado hoy —
// sobrevive a la rotación entre entidades y a que AsignacionGuardia pase a
// ser un historial 100% auto-generado. Único destino de los recordatorios
// manuales de AlertaVencimientoService.
model GuardiaContacto {
  id        Int      @id @default(autoincrement())
  cedula    String
  email     String
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
  @@unique([companyId, cedula])
}

// Ficha personal editable desde la app (no desde Drive). Es la fuente de la
// verdad para el .json de "Datos_Personales" que syncEntidadesFolder crea o
// sobrescribe en la carpeta del guardia en cada sincronización — el archivo
// en Drive es un espejo de solo lectura, nunca se lee de vuelta.
model GuardiaFichaPersonal {
  id                         Int       @id @default(autoincrement())
  cedula                     String
  companyId                  Int
  company                    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  telefono                   String?
  email                      String?
  direccion                  String?
  fechaNacimiento            DateTime?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  // Datos laborales usados para autocompletar la generación de contratos
  // (ver ContractService) — independientes de AsignacionGuardia, que es un
  // historial de solo lectura generado por el sync de Drive y no debe
  // recibir campos editables a mano (ver comentario en ese modelo).
  horario                    String?
  puestoFormal               String?
  salarioAcordado            Float?
  // ID del .json ya creado en Drive para este guardia, para actualizarlo
  // directamente en vez de tener que listar la carpeta en cada sync.
  driveFileId                String?
  // Valores de campos personalizados definidos por PersonalFieldDefinition,
  // { [fieldDefinition.key]: string }. Todo se guarda como string (el
  // frontend interpreta según el `type` del campo) para no perder datos si
  // el tipo de un campo cambia después de que ya existan valores. Si un
  // campo se elimina, su key queda huérfana acá (no se borra retroactivamente
  // de las fichas ya guardadas — mismo criterio de "nunca destruir datos" que
  // el resto del módulo).
  camposPersonalizados       Json      @default("{}")
  updatedAt                  DateTime  @updatedAt
  @@unique([companyId, cedula])
}

// Definición de un campo personalizado de la Ficha Personal, creable desde la
// UI por cualquier usuario con acceso al módulo (sin requerir cambio de
// código). `key` es un slug derivado de `label` al crear el campo y no
// cambia después, aunque se edite `label` — es la llave que usan los JSON
// guardados en GuardiaFichaPersonal.camposPersonalizados.
model PersonalFieldDefinition {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key       String
  label     String
  type      String   // 'TEXT' | 'NUMBER' | 'DATE'
  // A qué ficha pertenece este campo — 'GUARDIA' (GuardiaFichaPersonal) o
  // 'PERSONAL_ADMIN' (AdministrativeStaffFicha). Cada grupo gestiona sus
  // propios campos personalizados sin mezclarse entre sí.
  scope     String   @default("GUARDIA")
  // En qué sección de la ficha se muestra — 'PERSONAL' (Datos personales) o
  // 'LABORAL' (Datos laborales). Fijo desde la creación, igual que `type`.
  category  String   @default("PERSONAL")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([companyId, scope, key])
  @@index([companyId])
}

// Ficha personal editable del personal administrativo (oficina) — análoga a
// GuardiaFichaPersonal pero sin los campos de datos laborales orientados a
// contratos de Guardias. `cedula` aquí es el identityKey sintético
// ("PA-" + últimos 16 caracteres del folderId de Drive) que ya usa
// EmployeeDriveFolder/EmployeeDocument para este grupo, no una cédula real.
model AdministrativeStaffFicha {
  id                         Int       @id @default(autoincrement())
  cedula                     String
  companyId                  Int
  company                    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departamento               String?
  fechaIngreso               DateTime?
  activo                     Boolean   @default(true)
  tipoContrato               String?
  telefono                   String?
  direccion                  String?
  contactoEmergenciaNombre   String?
  contactoEmergenciaTelefono String?
  salarioAcordado            Float?
  camposPersonalizados       Json      @default("{}")
  updatedAt                  DateTime  @updatedAt
  @@unique([companyId, cedula])
}

// Registro de auditoría de una fusión de cédulas duplicadas (ver
// CedulaMergeService). Operación irreversible sobre datos de producción —
// se deja rastro igual que el resto de las acciones consecuentes del módulo
// (AlertaVencimiento, DocumentReview) para poder explicar después por qué el
// historial de un guardia luce como luce.
model CedulaMergeLog {
  id            Int      @id @default(autoincrement())
  companyId     Int
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  cedulaOrigen  String
  cedulaDestino String
  nombreDestino String
  resumen       Json     // snapshot de cuántas filas se movieron por tabla
  mergedBy      Int
  merger        User     @relation(fields: [mergedBy], references: [id])
  mergedAt      DateTime @default(now())
  @@index([companyId])
}

// Bookkeeping de avisos de vencimiento (Fase C) enviados por correo al
// guardia. Evita reenviar el mismo aviso todos los días: antes de enviar se
// busca una fila con éxito para (employeeDocumentId, requisitoDocumentoId,
// expiryDateAlertado=EmployeeDocument.expiryDate actual) — si RRHH corrige la
// fecha después, el snapshot cambia y un nuevo aviso vuelve a ser elegible.
// Los intentos fallidos (success=false, p. ej. delegación de dominio aún sin
// configurar) se reintentan al día siguiente en vez de tratarse como enviados.
model AlertaVencimiento {
  id                   Int      @id @default(autoincrement())
  employeeDocumentId   Int
  employeeDocument     EmployeeDocument @relation(fields: [employeeDocumentId], references: [id], onDelete: Cascade)
  requisitoDocumentoId Int
  requisitoDocumento   RequisitoDocumento @relation(fields: [requisitoDocumentoId], references: [id], onDelete: Cascade)
  expiryDateAlertado   DateTime  // snapshot de EmployeeDocument.expiryDate al momento del envío
  sentAt               DateTime  @default(now())
  success              Boolean   @default(true)
  errorMessage         String?
  companyId            Int
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([employeeDocumentId, requisitoDocumentoId, expiryDateAlertado])
  @@index([companyId])
}

// type distingue configuraciones independientes de carpeta raíz por área del
// módulo Personal: 'CUMPLIMIENTO' (Custodios + Personal Administrativo, el
// comportamiento histórico) y 'RECLUTAMIENTO' (candidatos/vacantes, su propia
// carpeta separada). Default 'CUMPLIMIENTO' preserva el comportamiento de las
// filas existentes tras la migración.
model FolderConfig {
  id              Int      @id @default(autoincrement())
  driveFolderId   String
  driveFolderName String
  type            String   @default("CUMPLIMIENTO")
  companyId       Int
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  @@unique([companyId, type])
}

enum VisitStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum VisitOutcome {
  INTERESTED
  QUOTED
  CLOSED_SALE
  NOT_INTERESTED
  FOLLOW_UP
}

enum LeadSource {
  GOOGLE_ADS
  WEB_FORM
  EMAIL
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTED
  WON
  LOST
}

model SalesGoal {
  id               Int      @id @default(autoincrement())
  userId           Int
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyVisitGoal  Int      @default(20)
  year             Int
  weekNumber       Int
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, userId, year, weekNumber])
}

model ClientVisit {
  id              Int          @id @default(autoincrement())
  userId          Int
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientName      String
  clientAddress   String?
  clientPhone     String?
  visitDate       DateTime
  status          VisitStatus  @default(PLANNED)
  checkInTime     DateTime?
  checkInLat      Float?
  checkInLng      Float?
  isVerified      Boolean      @default(false)
  commercialOffer String?
  quotedAmount    Float?       @default(0)
  outcome         VisitOutcome?
  notes           String?
  companyId       Int
  company         Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([companyId, userId])
}

model Lead {
  id             Int        @id @default(autoincrement())
  fullName       String
  email          String?
  phone          String?
  companyName    String?
  source         LeadSource @default(WEB_FORM)
  status         LeadStatus @default(NEW)
  assignedUserId Int?
  assignedUser   User?      @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  campaignName   String?
  estimatedValue Float?     @default(0)
  closedValue    Float?     @default(0)
  notes          String?
  companyId      Int
  company        Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([companyId, assignedUserId])
}

model SalesApiKey {
  id          Int      @id @default(autoincrement())
  name        String
  apiKey      String   @unique
  isActive    Boolean  @default(true)
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([companyId])
}

model JobPosition {
  id                 Int      @id @default(autoincrement())
  puesto             String
  descripcion        String?
  // Array de { nombre: string, tipo?: string } — tipo es una de CAMPO_TIPOS
  // (TEXTO/ALFANUMERICO/NUMERICO/CORREO/TELEFONO/FECHA), solo guía visual
  // para RRHH, el sistema no valida el contenido del formulario externo.
  camposRequeridos   Json     @default("[]")
  // Array de { nombre: string, extensiones?: string[] } — extensiones es solo
  // guía visual para RRHH/candidato (ej. CV → pdf/doc), el sistema no valida
  // ni rechaza archivos por extensión (el candidato sube directo a Drive).
  archivosRequeridos Json     @default("[]")
  // ABIERTA (recibe candidatos) | CERRADA (ya no recibe candidatos)
  estado             String   @default("ABIERTA")
  driveFileId        String?
  // Carpeta propia del puesto dentro de RECLUTAMIENTO (contiene el JSON y las
  // carpetas de los candidatos postulados a esta vacante).
  driveFolderId      String?
  companyId          Int
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
}

enum TipoMovimientoPersonal {
  ENTRADA
  SALIDA
}

enum EstadoMovimientoPersonal {
  EN_PROCESO
  COMPLETADO
}

// Catálogo configurable de sistemas externos donde RRHH debe registrar o dar
// de baja manualmente a un guardia (IsyPlus, IESS, SUT, SICOSEP...). No hay
// scraping (ver backend/scraping-poc/README.md) — esto solo define qué items
// de checklist se generan al abrir un caso; el registro en el portal externo
// lo hace una persona.
model SistemaVerificacion {
  id        Int      @id @default(autoincrement())
  nombre    String
  urlPortal String?
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     MovimientoPersonalItem[]

  @@unique([companyId, nombre])
  @@index([companyId])
}

// Caso/expediente de entrada o salida de un guardia (identificado por cedula,
// sin tabla maestra propia — mismo patrón que AsignacionGuardia/Certification
// en este schema). Cada entrada o salida de la misma persona a lo largo del
// tiempo es una fila independiente, para ver el historial completo.
model MovimientoPersonal {
  id            Int                      @id @default(autoincrement())
  cedula        String
  nombreGuardia String
  tipo          TipoMovimientoPersonal
  estado        EstadoMovimientoPersonal @default(EN_PROCESO)
  // Trazabilidad de origen, texto libre: "KANBAN_COLUMNA:<nombre>" | "MANUAL"
  origen        String
  candidateId   Int?
  candidate     Candidate?               @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  companyId     Int
  company       Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     Int
  creator       User                     @relation(fields: [createdBy], references: [id])
  createdAt     DateTime                 @default(now())
  completadoAt  DateTime?
  items         MovimientoPersonalItem[]

  @@index([companyId, cedula])
  @@index([companyId, tipo, estado])
}

// Item de checklist dentro de un caso — snapshot del catálogo
// SistemaVerificacion al momento de crear el caso (nombreSistema copiado).
// Si el catálogo cambia después, los casos ya creados no se ven afectados.
model MovimientoPersonalItem {
  id                    Int                  @id @default(autoincrement())
  movimientoId          Int
  movimiento            MovimientoPersonal   @relation(fields: [movimientoId], references: [id], onDelete: Cascade)
  sistemaVerificacionId Int?
  sistemaVerificacion   SistemaVerificacion? @relation(fields: [sistemaVerificacionId], references: [id], onDelete: SetNull)
  nombreSistema         String
  completado            Boolean              @default(false)
  notas                 String?
  completadoPor         Int?
  completador           User?                @relation(fields: [completadoPor], references: [id])
  completadoAt          DateTime?
  createdAt             DateTime             @default(now())

  @@index([movimientoId])
}

// Revision documental (Sprint 3): estado actual de aprobacion/rechazo.
// Se revisa un tipo de documento del checklist (documentTypeId) o, si el archivo
// no matchea ningun tipo, el archivo suelto de Drive (driveFileId).
// La unicidad se define con indices parciales en la migracion SQL, porque
// documentTypeId es nullable y Prisma no soporta indices unicos parciales.
model DocumentReview {
  id                  Int      @id @default(autoincrement())
  cedula              String
  documentTypeId      Int?
  documentType        DocumentType? @relation(fields: [documentTypeId], references: [id], onDelete: Cascade)
  driveFileId         String?  // solo para archivos sueltos (documentTypeId null)
  status              String   @default("PENDIENTE") // PENDIENTE | APROBADO | RECHAZADO
  reason              String?
  reviewedDriveFileId String?  // snapshot del archivo revisado, para detectar re-subidas
  reviewedFileName    String?
  reviewedBy          Int
  reviewer            User     @relation(fields: [reviewedBy], references: [id])
  reviewedAt          DateTime @default(now())
  companyId           Int
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  history             DocumentReviewHistory[]

  @@index([companyId, cedula])
}

// Traza append-only de cada aprobacion/rechazo. documentTypeName va denormalizado
// para que el historial siga siendo legible si renombran o borran el DocumentType.
model DocumentReviewHistory {
  id               Int      @id @default(autoincrement())
  reviewId         Int
  review           DocumentReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  cedula           String
  documentTypeName String
  fromStatus       String?
  toStatus         String
  reason           String?
  driveFileId      String?
  fileName         String?
  performedBy      Int
  performer        User     @relation(fields: [performedBy], references: [id])
  companyId        Int
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@index([companyId, cedula])
}

model SalesTemplate {
  id                 Int      @id @default(autoincrement())
  name               String
  description        String?
  driveUrl           String?  // Link de Google Drive con el .docx
  docxPath           String?  // Ruta local del .docx descargado
  generatedPdfPath   String?  // Ruta del último PDF generado
  boldsignTemplateId String?
  emailSubject       String?  // Asunto por defecto del correo
  emailBody          String?  // Cuerpo por defecto del correo
  companyId          Int
  createdBy          Int
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator  User            @relation(fields: [createdBy], references: [id])
  fields   SalesField[]
  contracts SalesContract[]

  @@index([companyId])
}

model SalesField {
  id               Int      @id @default(autoincrement())
  templateId       Int
  variableName     String   // Nombre de la variable en el doc: "ClientName"
  label            String   // Etiqueta visible en el form
  fieldType        String   // TEXT, NUMBER, DATE, EMAIL, CHECKBOX, DROPDOWN, SIGNATURE
  isRequired       Boolean  @default(true)
  isClientField    Boolean  @default(false) // true = cliente llena
  defaultValue     String?
  dropdownOptions  String[]
  order            Int      @default(0)

  template SalesTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model SalesContract {
  id                  Int      @id @default(autoincrement())
  templateId          Int
  clientName          String
  clientEmail         String
  clientPhone         String?
  clientCompany       String?
  clientRuc           String?
  clientAddress       String?
  fieldValues         Json     // {variableName: value} — campos del vendedor
  annexA              Json?    // Equipos
  annexB              Json?    // Servicios
  annexC              Json?    // Contactos
  generatedPdfPath    String?  // Ruta del PDF generado
  boldsignDocumentId  String?
  boldsignStatus      String?
  status              String   @default("DRAFT") // DRAFT, GENERATING, READY, SENT, SIGNED, CANCELLED
  sentAt              DateTime?
  signedAt            DateTime?
  companyId           Int
  createdBy           Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  creator  User          @relation(fields: [createdBy], references: [id])
  template SalesTemplate @relation(fields: [templateId], references: [id])
  contractDocuments SalesContractDocument[]

  @@index([companyId, status])
}

model SalesContractDocument {
  id         Int      @id @default(autoincrement())
  contractId Int
  type       String   // GENERADO, ENVIADO
  filePath   String   // "/api/ventas/contratos/file/{fileName}"
  createdAt  DateTime @default(now())

  contract SalesContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
}
